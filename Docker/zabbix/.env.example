# Zabbix Variables
ZABBIX_POSTGRES_IMAGE_TAG=postgres:17
ZABBIX_SERVER_IMAGE_TAG=zabbix/zabbix-server-pgsql:alpine-7.0-latest
ZABBIX_WEB_IMAGE_TAG=zabbix/zabbix-web-nginx-pgsql:alpine-7.0-latest
ZABBIX_AGENT_IMAGE_TAG=zabbix/zabbix-agent2:alpine-7.0-latest
ZABBIX_DB_NAME=zabbixdb
ZABBIX_DB_USER=zabbixdbuser
ZABBIX_DB_PASSWORD=changeme
ZABBIX_SERVER_HOSTNAME=zabbix.test.net
ZABBIX_DASHBOARD_HOSTNAME=dashboard.zabbix.test.net
ZABBIX_CACHESIZE=1G
# Timezone inside container
# A list of these tz database names can be looked up at Wikipedia
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
ZABBIX_TIMEZONE=Asia/Kathmandu

# Backup Variables
ZABBIX_BACKUP_INIT_SLEEP=30m
ZABBIX_BACKUP_INTERVAL=24h
ZABBIX_POSTGRES_BACKUP_PRUNE_DAYS=7
ZABBIX_POSTGRES_BACKUPS_PATH=/mnt/backups
ZABBIX_POSTGRES_BACKUP_NAME=zabbix-postgres-backup
